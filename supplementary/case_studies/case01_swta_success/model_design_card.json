  "constraints": [
    {
      "description": "Each target may be engaged at most once.",
      "formula_text": "for every target t in T: sum_{e in E: target[e]=t} x_e <= 1",
      "id": "C_target_at_most_one",
      "name": "target_at_most_one",
      "public_data_ref": [
        "derived_public_facts.temporal_action_space.compatible_engagements",
        "public_instance_data.sets.targets"
      ]
    },
    {
      "description": "For each sensor s and public time step tau, selected tracking workload cannot exceed sensor channel capacity.",
      "formula_text": "for every sensor s in S and time step tau: sum_{e in E: sensor[e]=s and tracking_start_step[e] <= tau <= tracking_end_step[e]} target_channel_need[target[e]] * x_e <= sensor_channel_capacity[s]",
      "id": "C_sensor_channel_capacity_time_indexed_weighted",
      "name": "sensor_channel_capacity_time_indexed_weighted",
      "public_data_ref": [
        "derived_public_facts.temporal_action_space.compatible_engagements",
        "public_instance_data.sensor_channel_capacity",
        "public_instance_data.target_channel_need"
      ]
    },
    {
      "description": "Selected engagements per weapon_vehicle cannot exceed public weapon inventory.",
      "formula_text": "for every weapon_vehicle w in W: sum_{e in E: weapon_vehicle[e]=w} x_e <= weapon_inventory[w]",
      "id": "C_weapon_inventory",
      "name": "weapon_inventory",
      "public_data_ref": [
        "derived_public_facts.temporal_action_space.compatible_engagements",
        "public_instance_data.weapon_inventory"
      ]
    },
    {
      "description": "Same-weapon launch interval enforced on hit_step proxy using compact sliding-window.",
      "formula_text": "for every weapon_vehicle w and every public hit_step window [h, h + weapon_min_launch_interval_steps[w] - 1] over observed hit_step anchors: sum_{e in E: weapon_vehicle[e]=w and hit_step[e] in [h, h + L_w - 1]} x_e <= 1, where L_w = weapon_min_launch_interval_steps[w]; equal hit_step conflicts included.",
      "id": "C_weapon_min_launch_interval",
      "name": "weapon_min_launch_interval",
      "public_data_ref": [
        "derived_public_facts.temporal_action_space.compatible_engagements",
        "public_instance_data.weapon_min_launch_interval_steps"
      ]
    }
  ],
