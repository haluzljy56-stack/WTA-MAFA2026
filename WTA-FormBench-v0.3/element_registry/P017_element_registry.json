{
  "paper_id": "P017",
  "contract_version": "R6C_element_registry_v1.0",
  "elements": {
    "SET:W": {
      "id": "SET:W",
      "kind": "set",
      "meaning": "defensive weapons"
    },
    "SET:M_t": {
      "id": "SET:M_t",
      "kind": "set",
      "meaning": "current missile storage list at sampling time t"
    },
    "SET:Tau": {
      "id": "SET:Tau",
      "kind": "set",
      "meaning": "sampling decision times"
    },
    "PAR:s_i_t": {
      "id": "PAR:s_i_t",
      "kind": "parameter",
      "meaning": "distance from missile i to the protected asset at sampling time t"
    },
    "PAR:D_i_t": {
      "id": "PAR:D_i_t",
      "kind": "parameter",
      "meaning": "damage intensity of missile i at sampling time t"
    },
    "PAR:p_wi_t": {
      "id": "PAR:p_wi_t",
      "kind": "parameter",
      "meaning": "probability that weapon w destroys missile i at sampling time t"
    },
    "PAR:available_i_t": {
      "id": "PAR:available_i_t",
      "kind": "parameter",
      "meaning": "1 if missile i is currently in the storage list and not already destroyed or hit the asset"
    },
    "PAR:C_switch": {
      "id": "PAR:C_switch",
      "kind": "parameter",
      "meaning": "optional negative reward constant for switching a weapon's target between steps"
    },
    "PAR:t_step": {
      "id": "PAR:t_step",
      "kind": "parameter",
      "meaning": "sampling time interval"
    },
    "PAR:current_storage_capacity": {
      "id": "PAR:current_storage_capacity",
      "kind": "parameter",
      "meaning": "upper limit M of the missile storage list / action index space"
    },
    "VAR:a_w_t": {
      "id": "VAR:a_w_t",
      "kind": "variable",
      "meaning": "missile number selected by weapon w at sampling time t; 0 means no attack"
    },
    "VAR:x_wi_t": {
      "id": "VAR:x_wi_t",
      "kind": "variable",
      "meaning": "binary equivalent: 1 if weapon w selects missile i at sampling time t"
    },
    "DER:th_i_t": {
      "id": "DER:th_i_t",
      "kind": "derived",
      "meaning": "missile threat degree"
    },
    "DER:hit_reward_wi_t": {
      "id": "DER:hit_reward_wi_t",
      "kind": "derived",
      "meaning": "current-stage threat-reduction value of assigning weapon w to missile i"
    },
    "DER:residual_environment_threat": {
      "id": "DER:residual_environment_threat",
      "kind": "derived",
      "meaning": "overall remaining threat used in reward/evaluation"
    },
    "DER:storage_update": {
      "id": "DER:storage_update",
      "kind": "derived",
      "meaning": "time-driven storage-list state update"
    },
    "OBJ:OBJ1": {
      "id": "OBJ:OBJ1",
      "kind": "objective",
      "meaning": "maximize current sampling-step threat eliminated by weapon assignments"
    },
    "CON:C1": {
      "id": "CON:C1",
      "kind": "constraint",
      "meaning": "a weapon can hit at most one target at a time"
    },
    "CON:C2": {
      "id": "CON:C2",
      "kind": "constraint",
      "meaning": "a weapon can select only missiles in the current storage list and selectable/unmasked actions"
    },
    "CON:C3": {
      "id": "CON:C3",
      "kind": "constraint",
      "meaning": "selected action is no-attack or a valid missile index"
    },
    "CON:C4": {
      "id": "CON:C4",
      "kind": "constraint",
      "meaning": "time-driven dynamic state update, not a full horizon survival recurrence"
    },
    "CON:C5": {
      "id": "CON:C5",
      "kind": "constraint",
      "meaning": "binary current-step assignment"
    },
