  {
    "element_id": "CON:C4",
    "type": "CON",
    "canonical_name": "C4",
    "meaning": "only healthy missiles are admitted",
    "master_spec_binding": {
      "id": "C4",
      "formula": "s_i = 1 for all available i",
      "meaning": "only healthy missiles are admitted",
      "source": "Eq. (10)",
