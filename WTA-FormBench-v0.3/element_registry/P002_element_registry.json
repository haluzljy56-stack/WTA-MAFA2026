  {
    "element_id": "DERIVED:m_mu",
    "type": "DERIVED",
    "canonical_name": "m_mu",
    "meaning": "number of defender missiles allocated/launched to area mu",
    "master_spec_binding": {
      "id": "m_mu(x)",
      "formula": "sum_i sum_{j in J_mu} x_ij",
      "meaning": "number of defender missiles allocated/launched to area mu"
    },
    "source_trace_binding": "master_spec.derived"
  },
  {
    "element_id": "DERIVED:P_ci",
    "type": "DERIVED",
    "canonical_name": "P_ci",
    "meaning": "probability missile i is not intercepted; equivalent to paper Eq. (2); zero-allocation areas are excluded by reliability constraints",
    "master_spec_binding": {
      "id": "P_ci(x)",
      "formula": "(1 - P_qi / m_mu(x))^(n_mu) for missile i assigned to area mu",
      "meaning": "probability missile i is not intercepted; equivalent to paper Eq. (2); zero-allocation areas are excluded by reliability constraints"
    },
    "source_trace_binding": "master_spec.derived"
  },
  {
    "element_id": "DERIVED:R_ij",
    "type": "DERIVED",
    "canonical_name": "R_ij",
    "meaning": "mission reliability contribution of missile i against target j",
    "master_spec_binding": {
      "id": "R_ij(x)",
      "formula": "r_i * r_ei * P_ci(x) * P_ij",
      "meaning": "mission reliability contribution of missile i against target j"
    },
    "source_trace_binding": "master_spec.derived"
  },
  {
    "element_id": "DERIVED:R_j",
    "type": "DERIVED",
    "canonical_name": "R_j",
    "meaning": "reliability of destroying target j",
    "master_spec_binding": {
      "id": "R_j(x)",
      "formula": "1 - product_i (1-R_ij(x))^(x_ij)",
      "meaning": "reliability of destroying target j"
    },
    "source_trace_binding": "master_spec.derived"
  },
  {
    "element_id": "DERIVED:R_mu",
    "type": "DERIVED",
    "canonical_name": "R_mu",
    "meaning": "mission reliability of area mu",
    "master_spec_binding": {
      "id": "R_mu(x)",
      "formula": "product_{j in J_mu} R_j(x)",
      "meaning": "mission reliability of area mu"
    },
    "source_trace_binding": "master_spec.derived"
  },
  {
    "element_id": "DERIVED:R_all",
    "type": "DERIVED",
    "canonical_name": "R_all",
    "meaning": "overall serial mission reliability",
    "master_spec_binding": {
      "id": "R_all(x)",
      "formula": "product_{mu in A} R_mu(x)",
