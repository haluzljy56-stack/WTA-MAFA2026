  },
  {
    "element_id": "OBJ:F1",
    "type": "OBJ",
    "canonical_name": "F1",
    "meaning": "efficiency-cost ratio",
    "master_spec_binding": {
      "id": "F1",
      "sense": "maximize",
      "formula": "(sum_j V_j R_j(x)) / (sum_i sum_j C_i x_ij)",
      "meaning": "efficiency-cost ratio",
      "source": "Eq. (5)"
    },
    "source_trace_binding": "Eq. (5)"
  },
  {
