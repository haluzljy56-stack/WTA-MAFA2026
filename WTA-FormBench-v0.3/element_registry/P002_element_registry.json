    "source_trace_binding": "Eq. (10)"
  },
  {
    "element_id": "CON:C5",
    "type": "CON",
    "canonical_name": "C5",
    "meaning": "only in-range missile-target pairs are admitted",
    "master_spec_binding": {
      "id": "C5",
      "formula": "d_ij <= D_i for every admitted pair (i,j)",
      "meaning": "only in-range missile-target pairs are admitted",
      "source": "Eq. (11)",
      "normalized_equivalent": "pre-filter assignment arcs"
    },
    "source_trace_binding": "Eq. (11)"
  },
  {
    "element_id": "CON:C6",
    "type": "CON",
    "canonical_name": "C6",
    "meaning": "each area must meet mission reliability threshold",
    "master_spec_binding": {
      "id": "C6",
      "formula": "R_mu(x) >= rho_mu for all mu",
      "meaning": "each area must meet mission reliability threshold",
