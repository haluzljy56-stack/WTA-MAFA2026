  {
    "element_id": "CON:C1",
    "type": "CON",
    "canonical_name": "C1",
    "meaning": "total assignments do not exceed available missiles",
    "master_spec_binding": {
      "id": "C1",
      "formula": "sum_i sum_j x_ij <= |I|",
      "meaning": "total assignments do not exceed available missiles",
      "source": "Eq. (7)"
    },
    "source_trace_binding": "Eq. (7)"
  },
  {
    "element_id": "CON:C2",
    "type": "CON",
    "canonical_name": "C2",
    "meaning": "each missile is allocated to at most one target",
    "master_spec_binding": {
      "id": "C2",
      "formula": "sum_j x_ij <= 1 for all i",
      "meaning": "each missile is allocated to at most one target",
      "source": "Eq. (8)"
    },
    "source_trace_binding": "Eq. (8)"
  },
  {
    "element_id": "CON:C3",
