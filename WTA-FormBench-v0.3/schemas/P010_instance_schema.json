{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P010 R4C instance schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "weapons",
    "targets",
    "weapon_target_kill_probability",
    "target_value",
    "target_kill_threshold"
  ],
  "properties": {
    "target_kill_threshold": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "target_value": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "weapon_target_kill_probability": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    }
  }
}
