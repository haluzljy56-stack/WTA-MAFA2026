{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P018 R6C instance schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "distance_pk_parameters",
    "engagement_distance_bounds",
    "feasible_firing_slots",
    "firing_delay",
    "heading_error_pk_parameters",
    "heading_vectors",
    "launcher_interceptor_capacity",
    "launcher_orientation",
    "launcher_positions",
    "launchers",
    "strategy_type",
    "target_max_interceptors",
    "target_pip_positions_by_launcher_time",
    "targets",
    "time_slots"
  ],
  "properties": {
    "distance_pk_parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "engagement_distance_bounds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "feasible_firing_slots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "firing_delay": {
      "type": "integer",
      "minimum": 0
    },
    "heading_error_pk_parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "heading_vectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "launcher_interceptor_capacity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "launcher_orientation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "launcher_positions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "launcher_rotational_velocity": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 1e-06
      }
    },
    "launchers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "maximum_rotation_angle": {
      "type": "number",
      "minimum": 0
    },
    "realignment_time": {
      "type": "number",
      "minimum": 0
    },
    "strategy_type": {
      "type": "string",
      "enum": [
        "RF",
        "R"
      ]
    },
    "target_max_interceptors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "target_pip_positions_by_launcher_time": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "time_slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
