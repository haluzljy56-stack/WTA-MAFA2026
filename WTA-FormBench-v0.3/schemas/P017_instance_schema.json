{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P017 R6C instance schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current_missile_storage_list",
    "missile_availability_mask",
    "missile_damage_intensity",
    "missile_distance_to_asset",
    "previous_weapon_action_if_switching_penalty_active",
    "sampling_interval",
    "switching_penalty_if_reward_style_sample",
    "weapon_missile_destroy_probability",
    "weapons"
  ],
  "properties": {
    "current_missile_storage_list": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      ]
    },
    "missile_availability_mask": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "missile_damage_intensity": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "missile_distance_to_asset": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number",
            "minimum": 1e-06
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 1e-06
            }
          }
        }
      ]
    },
    "previous_weapon_action_if_switching_penalty_active": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ]
      }
    },
    "sampling_interval": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 1e-06
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    },
    "switching_penalty_if_reward_style_sample": {
      "type": "number"
    },
    "weapon_missile_destroy_probability": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ]
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
