{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P005 R2D strengthened instance schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "weapon_categories",
    "targets",
    "stages",
    "weapon_unit_cost",
    "weapon_target_destroy_probability",
    "stage_weapon_inventory",
    "target_stage_availability",
    "target_damage_threshold"
  ],
  "properties": {
    "weapon_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "weapon_unit_cost": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "weapon_target_destroy_probability": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "stage_weapon_inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target_stage_availability": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target_damage_threshold": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "availability_stress_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
