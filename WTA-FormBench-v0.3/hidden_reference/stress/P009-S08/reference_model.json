  "sets": [
    {
      "id": "K",
      "meaning": "enemy targets",
      "index": "k"
    },
    {
      "id": "I",
      "meaning": "sensors",
      "index": "i"
    },
    {
      "id": "J",
      "meaning": "weapon vehicles",
      "index": "j"
    },
    {
      "id": "T",
      "meaning": "discrete interceptable moments",
      "index": "t"
    }
  ],
  "parameters": [
    {
      "id": "v_k",
      "meaning": "interception value of target k",
      "domain": "nonnegative"
    },
    {
      "id": "q_i_t_k",
      "meaning": "detection probability of target k by sensor i at time t",
      "domain": "[0,1]"
    },
    {
      "id": "p_j_t_k",
      "meaning": "interception probability of target k by weapon vehicle j at time t",
      "domain": "[0,1]"
    },
    {
      "id": "c_i_S",
      "meaning": "tracking cost of sensor i",
      "domain": "nonnegative"
    },
    {
      "id": "c_j_W",
      "meaning": "usage cost of weapon vehicle j",
      "domain": "nonnegative"
    },
    {
      "id": "Delta_k",
      "meaning": "time required to intercept target k after selected moment",
      "domain": "nonnegative"
    },
    {
      "id": "t_k_end",
      "meaning": "flight/impact time of target k",
      "domain": "positive"
    },
    {
      "id": "Cr_k",
      "meaning": "sensor channels required to track target k",
      "domain": "nonnegative integer"
    },
    {
      "id": "Delta_t_k_S",
      "meaning": "time required for target k to be consistently detected before hitting",
      "domain": "nonnegative"
    },
    {
      "id": "C_i_max",
      "meaning": "maximum channel capacity of sensor i",
      "domain": "nonnegative integer"
    },
    {
      "id": "N_j_max",
      "meaning": "weapon capacity of weapon vehicle j",
      "domain": "nonnegative integer"
    },
    {
      "id": "Delta_t_j_W",
      "meaning": "minimum firing time interval for weapon vehicle j",
      "domain": "nonnegative"
    },
    {
      "id": "mop_type",
      "meaning": "one of SWTA_MOP1,...,SWTA_MOP5 controlling spatial and probability generation rules",
      "domain": "categorical"
    }
  ],
  "variables": [
    {
      "id": "i_k",
      "meaning": "sensor assigned to target k; 0 means target k is discarded",
      "domain": "I union {0}"
    },
    {
      "id": "j_k",
      "meaning": "weapon vehicle assigned to target k; 0 means target k is discarded",
      "domain": "J union {0}"
    },
    {
      "id": "t_k",
      "meaning": "interception moment assigned to target k; 0 means target k is discarded",
      "domain": "T union {0}"
    }
  ],
  "objectives": [
    {
      "id": "F1",
      "sense": "minimize",
      "formula": "sum_k v_k * (1 - Q_k * P_k)",
      "meaning": "expected remaining interception value of targets"
    },
    {
      "id": "F2",
      "sense": "minimize",
      "formula": "sum_k (c^S_{i_k} + c^W_{j_k})",
      "meaning": "resource cost; zero cost for discarded targets"
    },
    {
      "id": "F3",
      "sense": "minimize",
      "formula": "max_k t_k",
      "meaning": "interception timeliness/makespan"
    },
    {
      "id": "F4",
      "sense": "minimize",
      "formula": "max_i R_i^S + max_j R_j^V",
      "meaning": "operational risk / load concentration"
    }
  ],
  "constraints": [
    {
      "id": "G1",
      "formula": "number of targets with t_hit_k > t_end_k must be zero",
      "meaning": "interception must be completed within target flight period"
    },
    {
      "id": "G2",
      "formula": "for each sensor and time, total required channel load of active assigned targets must not exceed C_i_max",
      "meaning": "sensor channel capacity"
    },
    {
      "id": "G3",
      "formula": "for each weapon vehicle j, number of assigned targets must not exceed N_j_max",
      "meaning": "weapon vehicle capacity"
    },
    {
      "id": "G4",
      "formula": "for each weapon vehicle j, assigned targets' firing times must satisfy minimum separation Delta_t_j_W",
      "meaning": "weapon firing time separation"
    },
    {
      "id": "DOMAIN",
      "formula": "x_k=[i_k,j_k,t_k], k=1..N_K, with zero tuple semantics for discarded targets",
      "meaning": "tuple decision domain"
    }
  ],
  "data_field_contract": {
